" herdr_splits — Vim-side navigation for herdr-splits. Neovim uses the Lua
" plugin (plugin/herdr-splits.lua); this file is the plain-Vim counterpart.
"
" Why a shim: the Neovim plugin is Lua over vim.api and cannot load in Vim,
" and Vim cannot reach Herdr's control pipe directly (ch_open rejects
" \\.\pipe\... — E475 on the MSYS and win32 builds alike). So at the split
" edge the direction is handed to the project's own pane-level entry point,
" scripts/herdr-nav.py --pane-only <direction>, which carries all of the
" semantics (most_recently_focused, unzoom_on_nav, nav_at_edge) and shares
" the mru-panes state with the Neovim side.
"
" Public entry point: herdr_splits#nav('h'|'j'|'k'|'l'). Mappings are
" defined by plugin/herdr-splits.vim, only inside a Herdr pane.

if has('nvim')
  finish
endif

" This checkout's root (…/autoload/herdr_splits.vim -> …). <sfile> is only a
" path while sourcing, so resolve it here, not inside a function.
let s:root = expand('<sfile>:p:h:h')
let s:dirs = {'h': 'left', 'j': 'down', 'k': 'up', 'l': 'right'}
let s:handoff_warn_armed = 1

" --- most_recently_focused window movement --------------------------------
" Port of nav.lua's MRU path: among the windows adjacent in a direction
" (the same nearest-layer rule as geometry.lua), move to the most recently
" focused one instead of letting wincmd pick by cursor row. Enabled by the
" shared herdr-splits.conf (most_recently_focused=true, generated by the
" Neovim setup()) or overridden per editor with
" g:herdr_splits_most_recently_focused.

let s:mru = {}
let s:mru_counter = 0

function! s:mru_bump() abort
  let s:mru_counter += 1
  let s:mru[win_getid()] = s:mru_counter
endfunction

augroup herdr_splits_mru
  autocmd!
  autocmd WinEnter * call s:mru_bump()
augroup END

" Same path resolution as the Python side (herdr_common.resolve_config_path).
function! s:conf_most_recently_focused() abort
  let l:path = $HERDR_SPLITS_CONFIG
  if empty(l:path)
    if !empty($HERDR_PLUGIN_CONFIG_DIR)
      let l:path = $HERDR_PLUGIN_CONFIG_DIR . '/herdr-splits.conf'
    elseif !empty($APPDATA)
      let l:path = $APPDATA . '\herdr\plugins\config\herdr-splits\herdr-splits.conf'
    else
      let l:path = expand('~/.config/herdr/plugins/config/herdr-splits/herdr-splits.conf')
    endif
  endif
  return filereadable(l:path)
        \ && match(readfile(l:path), '^\s*most_recently_focused\s*=\s*true') >= 0
endfunction

function! s:most_recently_focused() abort
  if exists('g:herdr_splits_most_recently_focused')
    return g:herdr_splits_most_recently_focused ? 1 : 0
  endif
  return s:conf_most_recently_focused()
endfunction

" Tiled rectangles of the current tabpage; project()/candidates() mirror
" geometry.lua (inclusive edges, nearest layer, perpendicular overlap). Vim
" has no float windows, so every entry is tiled.
function! s:tab_rects() abort
  let l:rects = []
  for w in getwininfo()
    if w.tabnr != tabpagenr() || w.width == 0 || w.height == 0
      continue
    endif
    call add(l:rects, {'id': w.winid, 'x': w.wincol - 1, 'y': w.winrow - 1, 'w': w.width, 'h': w.height})
  endfor
  return l:rects
endfunction

function! s:project(r, horiz) abort
  if a:horiz
    return [a:r.x, a:r.x + a:r.w - 1, a:r.y, a:r.y + a:r.h - 1]
  endif
  return [a:r.y, a:r.y + a:r.h - 1, a:r.x, a:r.x + a:r.w - 1]
endfunction

function! s:candidates(rects, cur, direction) abort
  let horiz = a:direction ==# 'left' || a:direction ==# 'right'
  let fwd = a:direction ==# 'right' || a:direction ==# 'down'
  let cur = {}
  for r in a:rects
    if r.id == a:cur
      let cur = r
      break
    endif
  endfor
  if empty(cur)
    return []
  endif
  let [cs, ce, cps, cpe] = s:project(cur, horiz)

  let best = 0
  let out = []
  for r in a:rects
    if r.id == a:cur
      continue
    endif
    let [s, e, ps, pe] = s:project(r, horiz)
    let gap = fwd ? s - ce : cs - e
    if gap >= 1 && ps <= cpe && pe >= cps
      if best == 0 || gap < best
        let best = gap
        let out = [r.id]
      elseif gap == best
        call add(out, r.id)
      endif
    endif
  endfor
  return out
endfunction

" Most recently focused among cands; ties keep the earliest (strict >).
" Returns 0 when cands is empty (window ids are positive).
function! s:mru_pick(cands) abort
  let best = 0
  let best_p = -1
  for id in a:cands
    let p = get(s:mru, id, 0)
    if p > best_p
      let best = id
      let best_p = p
    endif
  endfor
  return best
endfunction

" Move to the MRU window in {key}'s direction. Returns 1 when the cursor
" landed elsewhere; 0 lets the caller fall back to wincmd (edges, command
" line window, MRU disabled).
function! s:move_mru(key) abort
  let cands = s:candidates(s:tab_rects(), win_getid(), s:dirs[a:key])
  return !empty(cands) && win_gotoid(s:mru_pick(cands))
endfunction

" Path to scripts/herdr-nav.py, or '' when missing. An explicit
" g:herdr_splits_script always wins; otherwise use this checkout's own copy,
" so the Vim adapter and the helper it drives are the same commit (the same
" principle as lua/herdr-splits/paths.lua).
function! s:nav_script() abort
  let script = get(g:, 'herdr_splits_script', '')
  if empty(script)
    let script = s:root . '/scripts/herdr-nav.py'
  endif
  return filereadable(script) ? script : ''
endfunction

" Edge hand-off. Runs when wincmd could not move (Vim is at its edge) and
" $HERDR_ENV == 1. The pane-level decision belongs to herdr's own
" --pane-only entry point, so this stays glue: spawn it async so the
" keypress never blocks on the ~50ms python start (system() is unusable
" from Vim on Windows — verified: empty output / wrong exit codes — hence
" job_start()).
" Failures — script unresolved, interpreter missing, non-zero exit — warn
" once via echom, then stay silent; a clean run re-arms the warning.
function! s:warn_handoff(msg) abort
  if s:handoff_warn_armed
    let s:handoff_warn_armed = 0
    echom 'herdr-splits: ' . a:msg
  endif
endfunction

function! s:on_handoff_exit(job, status) abort
  if a:status == 0
    let s:handoff_warn_armed = 1
  else
    call s:warn_handoff('herdr-nav.py --pane-only exited with ' . a:status)
  endif
endfunction

function! s:edge_handoff(direction) abort
  let l:script = s:nav_script()
  if empty(l:script)
    call s:warn_handoff('herdr-nav.py not found (reinstall the plugin, or set g:herdr_splits_script)')
    return
  endif
  try
    let l:job = job_start(
          \ [get(g:, 'herdr_splits_python', 'python'), '-S', l:script, '--pane-only', a:direction],
          \ {'out_io': 'null', 'err_io': 'null',
          \  'exit_cb': function('s:on_handoff_exit')})
  catch
    call s:warn_handoff(v:exception)
    return
  endtry
  if job_status(l:job) ==# 'fail'
    call s:warn_handoff('could not start ' . get(g:, 'herdr_splits_python', 'python'))
  endif
endfunction

" Move to the split in {key}'s direction; at the edge, hand off to Herdr.
" With most_recently_focused (shared conf or g: override) a single move
" picks among the adjacent windows by focus recency, like the Neovim side;
" otherwise — and for counts — it is a plain wincmd move.
function! herdr_splits#nav(key) abort
  " Window commands are forbidden in the command-line window (E11).
  if getcmdwintype() !=# ''
    return
  endif
  " (Not `count`: Vim treats that name as read-only.)
  let move_count = v:count1
  if move_count == 1 && s:most_recently_focused() && s:move_mru(a:key)
    return
  endif
  let before = win_getid()
  execute (move_count > 1 ? string(move_count) : '') . 'wincmd ' . a:key
  " A count stays inside Vim: crossing a pane boundary is a single step.
  " (Neovim's count-at-edge path does cross; this is a deliberate divergence.)
  if win_getid() == before && move_count == 1 && $HERDR_ENV ==# '1'
    call s:edge_handoff(s:dirs[a:key])
  endif
endfunction


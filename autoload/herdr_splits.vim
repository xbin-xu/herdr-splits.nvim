" herdr_splits — Vim-side navigation for herdr-splits. Neovim uses the Lua
" plugin (plugin/herdr-splits.lua); this file is the plain-Vim counterpart.
"
" Why a shim: the Neovim plugin is Lua over vim.api and cannot load in Vim,
" and Vim cannot reach Herdr's control pipe directly (ch_open rejects
" \\.\pipe\... — E475 on the MSYS and win32 builds alike). So at the split
" edge the direction is handed to the project's own pane-level entry point,
" `scripts/bin/herdr-splits nav --pane-only <direction>` (or the Python
" fallback, scripts/herdr-nav.py), which carries all of the semantics
" (most_recently_focused, unzoom_on_nav, nav_at_edge) and shares the
" mru-panes state with the Neovim side.
"
" Public entry point: herdr_splits#nav('h'|'j'|'k'|'l'). Mappings are
" defined by plugin/herdr-splits.vim, only inside a Herdr pane.

if has('nvim')
  finish
endif

" This checkout's root (…/autoload/herdr_splits.vim -> …). <sfile> is only a
" path while sourcing, so resolve it here, not inside a function.
let s:root = expand('<sfile>:p:h:h')
let s:dirs = {'h': 'left', 'j': 'down', 'k': 'up', 'l': 'right'}
let s:handoff_warn_armed = 1

" --- most_recently_focused window movement --------------------------------
" Port of nav.lua's MRU path: among the windows adjacent in a direction
" (the same nearest-layer rule as geometry.lua), move to the most recently
" focused one instead of letting wincmd pick by cursor row. Enabled by the
" shared herdr-splits.conf (most_recently_focused=true, generated by the
" Neovim setup()) or overridden per editor with
" g:herdr_splits_most_recently_focused.

let s:mru = {}
let s:mru_counter = 0

function! s:mru_bump() abort
  let s:mru_counter += 1
  let s:mru[win_getid()] = s:mru_counter
endfunction

augroup herdr_splits_mru
  autocmd!
  autocmd WinEnter * call s:mru_bump()
augroup END

" Same path resolution as the Python side (herdr_common.resolve_config_path).
function! s:conf_most_recently_focused() abort
  let l:path = $HERDR_SPLITS_CONFIG
  if empty(l:path)
    if !empty($HERDR_PLUGIN_CONFIG_DIR)
      let l:path = $HERDR_PLUGIN_CONFIG_DIR . '/herdr-splits.conf'
    elseif !empty($APPDATA)
      let l:path = $APPDATA . '\herdr\plugins\config\herdr-splits\herdr-splits.conf'
    else
      let l:path = expand('~/.config/herdr/plugins/config/herdr-splits/herdr-splits.conf')
    endif
  endif
  return filereadable(l:path)
        \ && match(readfile(l:path), '^\s*most_recently_focused\s*=\s*true') >= 0
endfunction

function! s:most_recently_focused() abort
  if exists('g:herdr_splits_most_recently_focused')
    return g:herdr_splits_most_recently_focused ? 1 : 0
  endif
  return s:conf_most_recently_focused()
endfunction

" Tiled rectangles of the current tabpage; project()/candidates() mirror
" geometry.lua (inclusive edges, nearest layer, perpendicular overlap). Vim
" has no float windows, so every entry is tiled.
function! s:tab_rects() abort
  let l:rects = []
  for w in getwininfo()
    if w.tabnr != tabpagenr() || w.width == 0 || w.height == 0
      continue
    endif
    call add(l:rects, {'id': w.winid, 'x': w.wincol - 1, 'y': w.winrow - 1, 'w': w.width, 'h': w.height})
  endfor
  return l:rects
endfunction

function! s:project(r, horiz) abort
  if a:horiz
    return [a:r.x, a:r.x + a:r.w - 1, a:r.y, a:r.y + a:r.h - 1]
  endif
  return [a:r.y, a:r.y + a:r.h - 1, a:r.x, a:r.x + a:r.w - 1]
endfunction

function! s:candidates(rects, cur, direction) abort
  let horiz = a:direction ==# 'left' || a:direction ==# 'right'
  let fwd = a:direction ==# 'right' || a:direction ==# 'down'
  let cur = {}
  for r in a:rects
    if r.id == a:cur
      let cur = r
      break
    endif
  endfor
  if empty(cur)
    return []
  endif
  let [cs, ce, cps, cpe] = s:project(cur, horiz)

  let best = 0
  let out = []
  for r in a:rects
    if r.id == a:cur
      continue
    endif
    let [s, e, ps, pe] = s:project(r, horiz)
    let gap = fwd ? s - ce : cs - e
    if gap >= 1 && ps <= cpe && pe >= cps
      if best == 0 || gap < best
        let best = gap
        let out = [r.id]
      elseif gap == best
        call add(out, r.id)
      endif
    endif
  endfor
  return out
endfunction

" Most recently focused among cands; ties keep the earliest (strict >).
" Returns 0 when cands is empty (window ids are positive).
function! s:mru_pick(cands) abort
  let best = 0
  let best_p = -1
  for id in a:cands
    let p = get(s:mru, id, 0)
    if p > best_p
      let best = id
      let best_p = p
    endif
  endfor
  return best
endfunction

" Move to the MRU window in {key}'s direction. Returns 1 when the cursor
" landed elsewhere; 0 lets the caller fall back to wincmd (edges, command
" line window, MRU disabled).
function! s:move_mru(key) abort
  let cands = s:candidates(s:tab_rects(), win_getid(), s:dirs[a:key])
  return !empty(cands) && win_gotoid(s:mru_pick(cands))
endfunction

" Command (as an argv list) for the edge hand-off, or [] when nothing usable
" is installed. Preference order:
"   1. g:herdr_splits_bin — explicit pointer at the Rust helper,
"   2. this checkout's own build: scripts/bin/herdr-splits (the same binary the
"      Herdr-side actions run, ~10 ms instead of ~50 ms for a Python start),
"   3. the Python reference implementation, for a checkout that has not been
"      built yet (g:herdr_splits_script, else the shipped scripts/herdr-nav.py).
function! s:nav_command(direction) abort
  let bin = get(g:, 'herdr_splits_bin', '')
  if empty(bin)
    let candidate = s:root . '/scripts/bin/herdr-splits'
    if executable(candidate)
      let bin = candidate
    endif
  endif
  if !empty(bin)
    return extend([bin, 'nav', '--pane-only'], s:override_args()) + [a:direction]
  endif

  let script = get(g:, 'herdr_splits_script', '')
  if empty(script)
    let script = s:root . '/scripts/herdr-nav.py'
  endif
  if filereadable(script)
    return extend([get(g:, 'herdr_splits_python', 'python'), '-S', script, '--pane-only'],
          \ s:override_args()) + [a:direction]
  endif
  return []
endfunction

" Per-editor overrides of the shared conf, sent on the command line.
"
" The conf is one file per Herdr instance and only a Neovim setup() writes it,
" so a plain-Vim preference otherwise has no way in (and would be overwritten
" by whichever Neovim started last). Unset = let the conf decide:
"   let g:herdr_splits_nav_at_edge = 'stop'   " 'wrap' | 'stop'
"   let g:herdr_splits_unzoom_on_nav = 0      " 1 | 0
" g:herdr_splits_most_recently_focused is honoured too, so the pane-level pick
" agrees with the in-window one.
function! s:override_args() abort
  let l:args = []

  let l:edge = get(g:, 'herdr_splits_nav_at_edge', '')
  if !empty(l:edge)
    if l:edge ==# 'wrap' || l:edge ==# 'stop'
      call add(l:args, '--nav-at-edge=' . l:edge)
    else
      call s:warn_override('g:herdr_splits_nav_at_edge must be ''wrap'' or ''stop'' '
            \ . '(got ' . string(l:edge) . '); ignoring it')
    endif
  endif

  let l:unzoom = get(g:, 'herdr_splits_unzoom_on_nav', -1)
  if type(l:unzoom) == v:t_number && l:unzoom != -1
    call add(l:args, '--unzoom=' . (l:unzoom ? 'on' : 'off'))
  endif

  if exists('g:herdr_splits_most_recently_focused')
    call add(l:args, '--most-recently-focused='
          \ . (g:herdr_splits_most_recently_focused ? 'on' : 'off'))
  endif

  return l:args
endfunction

" Edge hand-off. Runs when wincmd could not move (Vim is at its edge) and
" $HERDR_ENV == 1. The pane-level decision belongs to the helper's
" --pane-only entry point, so this stays glue: hand the direction over
" synchronously.
"
" Synchronous on purpose. The helper is a short-lived process (measured on
" Windows: ~3-15 ms for the Rust build, ~70 ms for the python fallback), and a
" sync call means the focus has already moved when the chord ends: a second
" keypress cannot race a hand-off that has not happened yet. Vim has no blocking
" wait for jobs (job_status() only reports run/fail/dead; jobwait()/job_wait()
" are Neovim APIs), so "spawn and wait" would mean polling.
"
" The argv list is passed straight to the child: no shell, so no quoting and no
" dependency on 'shell'/'shellcmdflag' — a Windows path with spaces is fine.
" (The string form of system() goes through 'shell'; with shell=bash.exe a
" spaced or backslash path fails there, shellescape() included.) Builds that
" reject system({list}) — E730 on some Vim 9.1 nightlies — fall back to the
" async spawn rather than failing the chord.
"
" Failures — no helper found, interpreter missing, non-zero exit — warn once
" via echom, then stay silent; a clean run re-arms the warning.
" One-shot: a bad g: value is static, so say it once instead of per keypress.
let s:override_warn_armed = 1

function! s:warn_override(msg) abort
  if s:override_warn_armed
    let s:override_warn_armed = 0
    echom 'herdr-splits: ' . a:msg
  endif
endfunction

function! s:warn_handoff(msg) abort
  if s:handoff_warn_armed
    let s:handoff_warn_armed = 0
    echom 'herdr-splits: ' . a:msg
  endif
endfunction

function! s:on_handoff_status(status) abort
  if a:status == 0
    let s:handoff_warn_armed = 1
  else
    call s:warn_handoff('edge hand-off exited with ' . a:status)
  endif
endfunction

function! s:on_handoff_exit(job, status) abort
  call s:on_handoff_status(a:status)
endfunction

function! s:edge_handoff(direction) abort
  let l:command = s:nav_command(a:direction)
  if empty(l:command)
    call s:warn_handoff('no navigation helper found (build it: cargo build --release '
          \ . '--manifest-path rust/Cargo.toml, then cargo run --release '
          \ . '--manifest-path rust/Cargo.toml -- install)')
    return
  endif
  try
    call system(l:command)
    call s:on_handoff_status(v:shell_error)
    return
  catch
    " No system({list}) in this build: same argv, spawned asynchronously.
  endtry
  try
    let l:job = job_start(
          \ l:command,
          \ {'out_io': 'null', 'err_io': 'null',
          \  'exit_cb': function('s:on_handoff_exit')})
  catch
    call s:warn_handoff(v:exception)
    return
  endtry
  if job_status(l:job) ==# 'fail'
    call s:warn_handoff('could not start ' . l:command[0])
  endif
endfunction

" The key that starts a CTRL-W command in a terminal window (:h 'termwinkey').
" Empty — the default — means CTRL-W; a set value replaces it, and a chord with
" a hard-coded CTRL-W would then be typed into the job instead of running.
" The option keeps the key as it was written — a letter, `<C-L>` or `^I` — so it
" is turned into the key itself here: expression strings do not understand caret
" notation, and the `<...>` form needs the backslash form to expand.
function! s:term_prefix() abort
  let l:twk = &l:termwinkey
  if empty(l:twk)
    return "\<C-W>"
  endif
  if strlen(l:twk) == 1
    return l:twk
  endif
  if strlen(l:twk) == 2 && l:twk[0] ==# '^'
    return nr2char(l:twk[1] ==# '?' ? 127 : char2nr(toupper(l:twk[1])) - 64)
  endif
  try
    return eval('"\' . l:twk . '"')
  catch
    return "\<C-W>"
  endtry
endfunction

" RHS of the terminal-mode chord for {direction} — evaluated by the <expr>
" tnoremap while the terminal window is current (see plugin/herdr-splits.vim).
"
" Borrow, don't switch modes: in Terminal-Job mode `CTRL-W :` runs one Ex
" command and returns to Job mode (:h t_CTRL-W_:), the way <C-o> borrows Normal
" mode from Insert mode. `<C-\><C-n>` would park the terminal in Terminal-Normal
" mode instead, where Vim paints the shell scrollback like a buffer — line
" numbers, cursor in the output — until the user presses `i`. Leaving Job mode
" is the user's own gesture, not a side effect of navigating.
"
" Buffers listed in g:herdr_splits_terminal_skip_filetypes keep the key: the
" program inside owns it (fzf moves its list with CTRL-J/CTRL-K).
function! herdr_splits#term_nav(direction) abort
  let l:skip = get(g:, 'herdr_splits_terminal_skip_filetypes', [])
  if index(l:skip, &l:filetype) >= 0
    return eval('"\<C-' . a:direction . '>"')
  endif
  return s:term_prefix() . ':' . "\<C-U>"
        \ . "call herdr_splits#nav('" . a:direction . "')" . "\<CR>"
endfunction

" Move to the split in {key}'s direction; at the edge, hand off to Herdr.
" With most_recently_focused (shared conf or g: override) a single move
" picks among the adjacent windows by focus recency, like the Neovim side;
" otherwise — and for counts — it is a plain wincmd move.
"
" Called from the terminal-mode chord through `CTRL-W :` (see
" herdr_splits#term_nav), which leaves the terminal window in whatever mode it
" was in, and from normal mode. Extra arguments are accepted and ignored: older
" mappings passed a `1` for the removed Terminal-Job restore.
function! herdr_splits#nav(key, ...) abort
  call s:nav(a:key)
endfunction

function! s:nav(key) abort
  " Window commands are forbidden in the command-line window (E11).
  if getcmdwintype() !=# ''
    return
  endif
  " (Not `count`: Vim treats that name as read-only.)
  let move_count = v:count1
  if move_count == 1 && s:most_recently_focused() && s:move_mru(a:key)
    return
  endif
  let before = win_getid()
  execute (move_count > 1 ? string(move_count) : '') . 'wincmd ' . a:key
  " A count stays inside Vim: crossing a pane boundary is a single step.
  " (Neovim's count-at-edge path does cross; this is a deliberate divergence.)
  if win_getid() == before && move_count == 1 && $HERDR_ENV ==# '1'
    call s:edge_handoff(s:dirs[a:key])
  endif
endfunction

